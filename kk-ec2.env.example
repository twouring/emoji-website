# kk-ec2（AI GO Hosted App，deployd-single 單機管線）副本環境變數範本
# 用法：註冊 Hosted App 時 create_deployment:false → GET runtime-settings → 合併以下鍵 → PUT（全量替換）→ 建部署。
# 網域：deployd-single 只自動產生 <slug>.<HOSTED_DOMAIN>；www／pos／app／admin 子網域要在 Caddy 另加片段（見 docs/kk-ec2-deploy.md）。
# 下面以 slug＝emoji、HOSTED_DOMAIN＝deploy.43-213-238-222.nip.io 為例：裸網域 emoji.deploy.43-213-238-222.nip.io。
# 機敏值一律不填在此檔；副本不帶任何金流／寄信／推播／IG 金鑰，避免對外副作用。

NODE_ENV=production
CRON_MODE=off

# ── 四個入口（www／裸網域／pos／app）＋後台 ──
PUBLIC_ORIGIN=https://www.emoji.deploy.43-213-238-222.nip.io
APEX_HOSTS=emoji.deploy.43-213-238-222.nip.io
APEX_REDIRECT_ORIGIN=https://www.emoji.deploy.43-213-238-222.nip.io
POS_HOSTS=pos.emoji.deploy.43-213-238-222.nip.io
POS_ORIGIN=https://pos.emoji.deploy.43-213-238-222.nip.io
APP_HOSTS=app.emoji.deploy.43-213-238-222.nip.io
APP_ORIGIN=https://app.emoji.deploy.43-213-238-222.nip.io
ADMIN_HOSTS=admin.emoji.deploy.43-213-238-222.nip.io
ADMIN_ORIGIN=https://admin.emoji.deploy.43-213-238-222.nip.io
KTV_HOSTS=ktv.emoji.deploy.43-213-238-222.nip.io
SSO_ORIGIN=https://sso.emoji.deploy.43-213-238-222.nip.io
WEB_ORIGINS=https://www.emoji.deploy.43-213-238-222.nip.io,https://emoji.deploy.43-213-238-222.nip.io,https://pos.emoji.deploy.43-213-238-222.nip.io,https://app.emoji.deploy.43-213-238-222.nip.io,https://admin.emoji.deploy.43-213-238-222.nip.io

# ── 機敏（以 env_sensitive 設，值不寫進 repo）──
# APP_SECRET=<32+ 字元，副本專用，勿沿用正式站>
# PII_KEY=<副本專用>
# DATABASE_URL=<副本資料庫；不可指向正式 Cloud SQL>

# ── 刻意留空（副本不得對外發送）──
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / RESEND_API_KEY / LINE_* / IG_ACCESS_TOKEN / IG_AUTOPUBLISH / ANTHROPIC_API_KEY / S3_*
