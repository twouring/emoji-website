# Stripe sandbox（測試環境）— website 與 fellow 共用；一律使用 Emoji 言文字帳號 acct_1Ts2y95NXMKDsl40
# 複製為 .env 後填入實際金鑰。本檔可入版控，.env 不可。

# 公開金鑰：website 前端與 fellow 前端共用
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# 私密金鑰：僅 fellow 後端使用
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe Dashboard webhook signing secret；付費活動未設時會停用
STRIPE_WEBHOOK_SECRET=whsec_xxx

# 活動票券 QR 簽章；留空時沿用 ACCESS_QR_SECRET
# EVENT_QR_SECRET=replace-with-random-secret

# Google 登入（官網會員專區）— 僅 fellow 後端使用
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
# 活動主 Google Meet 整合；可與登入使用同一 Google Cloud 專案，但須另明確設定才啟用
# GOOGLE_MEET_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_MEET_CLIENT_SECRET=GOCSPX-xxx
# 活動主 Zoom 整合；OAuth app 需允許建立 Meeting，Webinar 另需帳號方案與權限
# ZOOM_CLIENT_ID=xxx
# ZOOM_CLIENT_SECRET=xxx
# Google Wallet：服務帳號 JSON 整份做 base64，搭配 Business Console issuer ID
# GOOGLE_WALLET_ISSUER_ID=1234567890
# GOOGLE_WALLET_SERVICE_ACCOUNT_B64=base64-json
# Apple Wallet：Pass Type ID 憑證、私鑰與 Apple WWDR 憑證皆以 base64 保存；同一 Pass 憑證也用於 APNs 更新通知
# APPLE_WALLET_PASS_TYPE_ID=pass.tw.emoji.events
# APPLE_WALLET_TEAM_ID=TEAMID
# APPLE_WALLET_WWDR_B64=base64-pem
# APPLE_WALLET_SIGNER_CERT_B64=base64-pem
# APPLE_WALLET_SIGNER_KEY_B64=base64-pem
# APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
# Twilio Verify 與 Messaging：電話驗證及活動 SMS／WhatsApp；WhatsApp 主動訊息可設定已核准 Content SID
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_VERIFY_SERVICE_SID=VAxxx
# TWILIO_MESSAGING_SERVICE_SID=MGxxx
# TWILIO_SMS_FROM=+1xxxxxxxxxx
# TWILIO_WHATSAPP_FROM=+1xxxxxxxxxx
# TWILIO_WHATSAPP_CONTENT_SID=HXxxx
# 瀏覽器推播 VAPID；可用 npx web-push generate-vapid-keys 產生，subject 使用 mailto: 或 https:
# WEB_PUSH_VAPID_PUBLIC_KEY=xxx
# WEB_PUSH_VAPID_PRIVATE_KEY=xxx
# WEB_PUSH_SUBJECT=mailto:events@emoji.tw
# Ethereum JSON-RPC HTTPS 端點；啟用 ERC-20／ERC-721 票種驗證時必填
# ETHEREUM_RPC_URL=https://ethereum-rpc.example.com
# 本地測試讓 Google 導回本機；正式環境使用 https://www.emoji.tw
# PUBLIC_ORIGIN=http://localhost:8080
# 官網來源白名單（CORS 與登入導回防護），逗號分隔；預設已含 www/emoji.tw 與 localhost:5500
# WEB_ORIGINS=https://www.emoji.tw,https://emoji.tw
